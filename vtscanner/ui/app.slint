    in-out property <string> api-type: "free";
    in-out property <string> lang: "ru";
    in-out property <bool> close-to-tray;
    in-out property <bool> autostart;
    callback f7sua4gyqbn();
}

export global Tr {
    pure callback fw9qy2wz84z(string, string) -> string;
    pure public function f3if9jqdip5(key: string) -> string {
        return Tr.fw9qy2wz84z(Cfg.lang, key);
    }
}

export global UiFlags {
    in-out property <bool> show-settings;

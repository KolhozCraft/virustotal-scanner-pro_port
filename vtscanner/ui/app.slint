global Theme {
    out property <bool> dark: Cfg.theme == "dark";
    out property <color> bg: dark ? #0d1016 : #eceff5;
    out property <color> surface: dark ? #151a23 : #ffffff;
    out property <color> surface-alt: dark ? #1d2430 : #f0f3f8;
    out property <color> surface-hover: dark ? #263042 : #e4e9f2;
    out property <color> surface-press: dark ? #2e3a50 : #d8dfec;
    out property <color> border: dark ? #263041 : #dbe1ec;
    out property <color> text: dark ? #e7ebf3 : #19212e;
    out property <color> dim: dark ? #8994a8 : #667189;
    out property <color> accent: dark ? #4f8cff : #2f6df0;
    out property <color> accent-hover: dark ? #6a9fff : #4a82f5;
    out property <color> accent-press: dark ? #3b74e3 : #2457c9;
    out property <color> success: dark ? #3ddc97 : #1fa971;
    out property <color> overlay: dark ? #000000b8 : #10182860;
}

component Section inherits Text {
    font-size: 12px;
    font-weight: 700;
    color: Theme.dim;
    animate color { duration: 250ms; }
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> flash;
    callback clicked();
    height: 36px;
    border-radius: 9px;
    border-width: root.primary ? 0px : 1px;
    border-color: root.flash ? Theme.success : (area.has-hover && root.enabled ? Theme.accent : Theme.border);
    background: !root.enabled ? Theme.surface-alt : (root.primary ? (area.pressed ? Theme.accent-press : (area.has-hover ? Theme.accent-hover : Theme.accent)) : (area.pressed ? Theme.surface-press : (area.has-hover ? Theme.surface-hover : Theme.surface-alt)));
    opacity: root.enabled ? 1.0 : 0.45;
    transform-scale: area.pressed && root.enabled ? 0.97 : 1.0;
    animate background { duration: 140ms; easing: ease-out; }
    animate border-color { duration: 140ms; easing: ease-out; }
    animate opacity { duration: 160ms; }
    animate transform-scale { duration: 90ms; easing: ease-out; }

    Text {
        text: root.text;
        font-size: 14px;
        font-weight: root.primary ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.primary ? #ffffff : (root.flash ? Theme.success : Theme.text);
        animate color { duration: 140ms; }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Radio inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    callback ffcrk7nwqy8();
    height: 28px;
    preferred-width: 28px + caption.preferred-width;

    ring := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 2px;
        border-color: root.checked ? Theme.accent : (area.has-hover ? Theme.dim : Theme.border);
        animate border-color { duration: 150ms; }

        Rectangle {
            width: root.checked ? 10px : 0px;
            height: root.checked ? 10px : 0px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: Theme.accent;
            animate width { duration: 180ms; easing: ease-out; }
            animate height { duration: 180ms; easing: ease-out; }
        }
    }

    caption := Text {
        x: 28px;
        height: parent.height;
        text: root.label;
        font-size: 14px;
        vertical-alignment: center;
        color: Theme.text;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.ffcrk7nwqy8();
        }
    }
}

component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();
    height: 30px;
    preferred-width: 30px + caption.preferred-width;

    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 20px;
        height: 20px;
        border-radius: 6px;
        border-width: 2px;
        border-color: root.checked ? Theme.accent : (area.has-hover ? Theme.dim : Theme.border);
        background: root.checked ? Theme.accent : transparent;
        animate background { duration: 150ms; easing: ease-out; }
        animate border-color { duration: 150ms; }

        Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M 1.5 6.5 L 4.8 9.8 L 10.5 2.8";
            stroke: #ffffff;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
            opacity: root.checked ? 1.0 : 0.0;
            animate opacity { duration: 140ms; }
        }
    }

    caption := Text {
        x: 30px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        vertical-alignment: center;
        color: Theme.text;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component MenuEntry inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 36px;
    border-radius: 7px;
    background: area.pressed ? Theme.surface-press : (area.has-hover ? Theme.surface-hover : transparent);
    animate background { duration: 120ms; }

    Text {
        x: 12px;
        height: parent.height;
        text: root.text;
        font-size: 14px;
        vertical-alignment: center;
        color: Theme.text;
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component StatusDot inherits Rectangle {
    in property <bool> active;
    in property <color> tint;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: root.tint;
    opacity: root.active ? 0.55 + 0.45 * Math.sin((animation-tick() / 1.1s) * 360deg) : 1.0;
    animate background { duration: 300ms; }
}

component Bar inherits Rectangle {
    in property <float> progress;
    in property <bool> busy;
    height: 8px;
    border-radius: 4px;
    background: Theme.surface-alt;
    clip: true;
    animate background { duration: 250ms; }

    Rectangle {
        x: 0px;
        width: root.width * Math.min(Math.max(root.progress, 0.0), 1.0);
        height: parent.height;
        border-radius: 4px;
        background: root.progress >= 1.0 ? Theme.success : Theme.accent;
        animate width { duration: 380ms; easing: ease-out; }
        animate background { duration: 300ms; }
    }

    if root.busy: Rectangle {
        width: parent.width * 0.28;
        height: parent.height;
        border-radius: 4px;
        x: -self.width + (parent.width + self.width) * Math.mod(animation-tick() / 1.5s, 1.0);
        background: #ffffff38;
    }
}

component Modal inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <length> card-width: 440px;
    in property <length> card-height: 200px;
    callback fnmcqxer628();
    background: Theme.overlay;
    opacity: root.open ? 1.0 : 0.0;
    visible: root.opacity > 0.01;
    animate opacity { duration: 200ms; easing: ease-out; }

    TouchArea { }

    Rectangle {
        width: min(root.card-width, root.width - 24px);
        height: min(root.card-height, root.height - 24px);
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + (root.open ? 0px : 18px);
        background: Theme.surface;
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 8px;
        transform-scale: root.open ? 1.0 : 0.96;
        animate y { duration: 240ms; easing: ease-out; }
        animate transform-scale { duration: 240ms; easing: ease-out; }
        animate background { duration: 250ms; }

        VerticalLayout {
            padding: 20px;
            spacing: 10px;
            alignment: start;

            HorizontalLayout {
                height: 34px;
                Text {
                    text: root.title;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    color: Theme.text;
                }
                Rectangle { }
                Btn {
                    text: "X";
                    width: 34px;
                    height: 34px;
                    clicked => {
                        root.fnmcqxer628();
                    }
                }
            }

            @children
        }
    }
}


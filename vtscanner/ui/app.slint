export component MainWindow inherits Window {
    title: "VirusTotal Scanner Pro";
    icon: @image-url("app.png");
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 780px;
    min-height: 580px;
    always-on-top: Cfg.topmost;
    background: Theme.bg;
    animate background { duration: 280ms; }

    property <bool> menu-open;
    property <bool> intro-ready;
    property <float> intro: root.intro-ready ? 1.0 : 0.0;
    property <bool> copied;
    animate intro { duration: 520ms; easing: ease-out; }

    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    changed dark => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <bool> dark: Theme.dark;

    intro-timer := Timer {
        interval: 40ms;
        running: true;
        triggered => {
            root.intro-ready = true;
            self.running = false;
        }
    }

    copy-timer := Timer {
        interval: 1500ms;
        running: root.copied;
        triggered => {
            root.copied = false;
        }
    }

    Rectangle {
        opacity: root.intro;
        y: (1.0 - root.intro) * 14px;

        VerticalLayout {
            Rectangle {
                height: 58px;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 8px;
                    spacing: 10px;

                    Image {
                        source: @image-url("app.png");
                        width: 30px;
                        height: 30px;
                        image-fit: contain;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "VirusTotal Scanner Pro";
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        color: Theme.text;
                        animate color { duration: 250ms; }
                    }
                    Rectangle { }
                    Rectangle {
                        width: chip-text.preferred-width + 28px;
                        height: 30px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 15px;
                        background: Theme.surface;
                        border-width: 1px;
                        border-color: Theme.border;
                        animate background { duration: 250ms; }
                        chip-text := Text {
                            text: Tr.f3if9jqdip5("requests_used") + ": " + AppState.requests-used;
                            font-size: 13px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: Theme.dim;
                        }
                    }
                    Btn {
                        text: Tr.f3if9jqdip5("actions");
                        width: 130px;
                        height: 34px;
                        y: (parent.height - self.height) / 2;
                        clicked => {
                            root.menu-open = !root.menu-open;
                        }
                    }
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-bottom: 14px;
                spacing: 14px;

                Rectangle {
                    width: 330px;
                    background: Theme.surface;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 250ms; }

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;
                        alignment: start;

                        Section { text: Tr.f3if9jqdip5("file_info"); }

                        Rectangle {
                            height: 118px;

                            Rectangle {
                                opacity: AppState.has-file ? 1.0 : 0.0;
                                animate opacity { duration: 260ms; easing: ease-out; }

                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    Text {
                                        text: AppState.file-name;
                                        font-size: 15px;
                                        font-weight: 700;
                                        wrap: word-wrap;
                                        color: Theme.text;
                                    }
                                    Text {
                                        text: AppState.file-size-text;
                                        font-size: 13px;
                                        color: Theme.dim;
                                    }
                                    Text {
                                        text: AppState.file-hash-text;
                                        font-size: 12px;
                                        wrap: char-wrap;
                                        color: Theme.dim;
                                    }
                                }
                            }

                            Text {
                                text: Tr.f3if9jqdip5("no_file");
                                font-size: 14px;
                                color: Theme.dim;
                                opacity: AppState.has-file ? 0.0 : 1.0;
                                animate opacity { duration: 260ms; easing: ease-out; }
                            }
                        }

                        Section { text: Tr.f3if9jqdip5("actions"); }

                        Btn {
                            text: Tr.f3if9jqdip5("select_file");
                            primary: true;
                            height: 42px;
                            enabled: !AppState.scanning;
                            clicked => {
                                Actions.fnhej4hffkb();
                            }
                        }
                        Btn {
                            text: Tr.f3if9jqdip5("rescan");
                            enabled: !AppState.scanning && AppState.rescan-enabled;
                            clicked => {
                                Actions.fkjezlxswmu();
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Btn {
                                text: root.copied ? Tr.f3if9jqdip5("copied") : Tr.f3if9jqdip5("copy_hash");
                                flash: root.copied;
                                clicked => {
                                    Actions.fvum2ylkwsn();
                                    root.copied = true;
                                }
                            }
                            Btn {
                                text: Tr.f3if9jqdip5("open_in_browser");
                                clicked => {
                                    Actions.f87pe0lfx7z();
                                }
                            }
                        }
                        Btn {
                            text: Tr.f3if9jqdip5("clear");
                            clicked => {
                                Actions.folpjypdhbi();
                            }
                        }

                        Rectangle {
                            height: AppState.show-check-now ? 44px : 0px;
                            opacity: AppState.show-check-now ? 1.0 : 0.0;
                            clip: true;
                            animate height { duration: 240ms; easing: ease-out; }
                            animate opacity { duration: 240ms; easing: ease-out; }

                            Btn {
                                y: 6px;
                                text: Tr.f3if9jqdip5("check_now");
                                primary: true;
                                clicked => {
                                    Actions.fned47nvlvc();
                                }
                            }
                        }

                        Section { text: Tr.f3if9jqdip5("status"); }

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            StatusDot {
                                y: 5px;
                                active: AppState.scanning;
                                tint: AppState.scanning ? Theme.accent : (AppState.progress >= 1.0 ? Theme.success : Theme.dim);
                            }
                            Text {
                                text: AppState.status-text;
                                font-size: 14px;
                                wrap: word-wrap;
                                color: Theme.text;
                            }
                        }

                        Bar {
                            progress: AppState.progress;
                            busy: AppState.scanning;
                        }
                        Text {
                            text: Math.round(AppState.progress * 100) + "%";
                            font-size: 12px;
                            horizontal-alignment: right;
                            color: Theme.dim;
                        }
                    }
                }

                Rectangle {
                    background: Theme.surface;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 250ms; }

                    VerticalLayout {
                        padding: 18px;
                        spacing: 10px;

                        Section { text: Tr.f3if9jqdip5("results"); }
                        TextEdit {
                            read-only: true;
                            wrap: word-wrap;
                            text: AppState.output-log;
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        width: root.width;
        height: root.height;
        visible: root.menu-open;
        TouchArea {
            clicked => {
                root.menu-open = false;
            }
        }
    }

    Rectangle {
        width: 230px;
        height: 124px;
        x: root.width - self.width - 18px;
        y: 54px + (root.menu-open ? 0px : -8px);
        opacity: root.menu-open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 20px;
        drop-shadow-color: #00000060;
        drop-shadow-offset-y: 6px;
        animate opacity { duration: 170ms; easing: ease-out; }
        animate y { duration: 170ms; easing: ease-out; }

        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            MenuEntry {
                text: Tr.f3if9jqdip5("change_api_key");
                clicked => {
                    root.menu-open = false;
                    UiFlags.show-api-key = true;
                }
            }
            MenuEntry {
                text: Tr.f3if9jqdip5("settings");
                clicked => {
                    root.menu-open = false;
                    UiFlags.show-settings = true;
                }
            }
            MenuEntry {
                text: Tr.f3if9jqdip5("about");
                clicked => {
                    root.menu-open = false;
                    UiFlags.show-about = true;
                }
            }
        }
    }

    SettingsModal {
        width: root.width;
        height: root.height;
        open: UiFlags.show-settings;
    }
    ApiKeyModal {
        width: root.width;
        height: root.height;
        open: UiFlags.show-api-key;
    }
    AboutModal {
        width: root.width;
        height: root.height;
        open: UiFlags.show-about;
    }
    ThanksModal {
        width: root.width;
        height: root.height;
        open: UiFlags.show-thanks;
    }
}
